# ─────────────────────────────────────────────────────────────────
# pi-configurator .gitignore
# Script bash + PowerShell, niente build artifacts.
#
# ATTENZIONE: in .gitignore un "#" a fine riga NON e' un commento,
# fa parte del pattern. I commenti vanno su una riga separata.
# Verifica: git check-ignore -v <path>
# ─────────────────────────────────────────────────────────────────

# ── macOS ──
.DS_Store
._*
.Spotlight-V100
.Trashes

# ── Windows ──
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.\#*
\#*\#

# ── Backup / temp ──
*.bak
*.tmp
*.orig
*.rej

# ── Test / build artifacts ──
*.log
logs/
coverage/
tmp/
test-output/
*.out

# ── Secrets & local config ──
# Lo script non salva segreti nel progetto, ma se aggiungi un .env per
# testare in locale evita commit accidentali.
.env
.env.*
!.env.example
*.key
*.pem
*.secret
*credentials*

# ── PowerShell ──
*.ps1.xml

# ── Shell history (se esegui script dalla repo) ──
.history
.bash_history_local
